# ---------------------------------------------------------------
# Grundregel: alles als Text behandeln, im Repo und im Working Tree LF
# ---------------------------------------------------------------
* text=auto eol=lf

# --- Vault-Inhalte explizit ------------------------------------
*.md        text eol=lf diff=markdown
*.canvas    text eol=lf
*.base      text eol=lf
*.json      text eol=lf
*.css       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.txt       text eol=lf
*.csv       text eol=lf

# --- Skripte: müssen plattformgerechte Zeilenenden behalten ----
*.sh        text eol=lf
*.nu        text eol=lf
*.py        text eol=lf
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# --- Binärdateien: niemals anfassen ----------------------------
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.avif      binary
*.svg       text eol=lf
*.ico       binary
*.pdf       binary
*.mp3       binary
*.m4a       binary
*.wav       binary
*.ogg       binary
*.mp4       binary
*.webm      binary
*.mov       binary
*.zip       binary
*.7z        binary
*.gz        binary
*.docx      binary
*.xlsx      binary
*.pptx      binary
*.odt       binary
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary
